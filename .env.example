# FreeShard WebCalendar — environment configuration
# Copy to .env and adjust. All variables are optional unless noted.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# Public URL of the calendar (scheme, host, optional path). Required in production: public
# share links, OAuth/OIDC redirect URIs and the CSRF origin check are derived from it.
# Proxy headers such as X-Forwarded-Host are never used for these.
BASE_URL=https://calendar.example.com
# Session cookie signing secret — set a long random string in production!
SESSION_SECRET=change-me
# Reverse proxy trust configuration: a hop count, 'false', proxy addresses/CIDRs, or 'true'
# (trust every hop). Production default: 1, the shard's reverse proxy; the client IP used for
# rate limiting is the address that proxy appended. 'true' would let clients pick their own IP
# through X-Forwarded-For.
TRUST_PROXY=1
# Session cookie secure flag ('auto', 'true', 'false')
COOKIE_SECURE=auto
# Session cookie SameSite attribute ('lax', 'strict', 'none'). 'lax' (default) lets the return from
# Google, Microsoft or an OIDC provider on another site carry the session; 'strict' breaks the Google
# and OIDC login callbacks. CSRF protection comes from the Origin/Sec-Fetch-Site check, not SameSite.
COOKIE_SAME_SITE=lax
# Secret used to encrypt stored CalDAV passwords / OAuth refresh tokens.
# Changing it invalidates all stored credentials. Set in production!
ENCRYPTION_KEY=change-me-32-chars-or-more
# SQLite database file (shared with Radicale plugins and sync-worker in Docker)
DATABASE_PATH=./webcalendar.db
# Serve HTTPS if both files exist; leave empty to force HTTP
SSL_KEY_PATH=./ssl/key.pem
SSL_CERT_PATH=./ssl/cert.pem

# ── Authentication ───────────────────────────────────────────────────────────
# 'env' or 'oidc'. A shard ships with 'env': one owner, whose user id is CALDAV_USERNAME (the store
# template sets CALDAV_USERNAME=owner). 'oidc' is for the shard's own OIDC provider, which shard_core
# does not offer yet; until it does, no shard has an issuer to point OIDC_ISSUER_URL at, and the
# multi-user features (sharing calendars between shard users) have no second user to work with.
# In production, env mode serves only requests from the FreeShard platform proxy: every request
# (except /health, /api/health and /internal/*) must carry X-Freeshard-Secret:
# <HTTP_HEADER_AUTH_SECRET>, anything else is 401, and the server refuses to start without that
# secret (#246) — set HTTP_HEADER_AUTH_SECRET below. Outside production env mode needs no secret.
AUTH_METHOD=env

# OIDC (AUTH_METHOD=oidc only): the server refuses to start without all three. No shard provides
# an issuer yet (see above).
#OIDC_ISSUER_URL=https://auth.example.com
#OIDC_CLIENT_ID=webcalendar
#OIDC_CLIENT_SECRET=
# Token endpoint client authentication (#490, #600). Unset: the methods the issuer's discovery
# metadata offers are checked at start (client_secret_basic first) and the first one the issuer
# accepts is used. A method the issuer rejects, or any other value, refuses to start.
#OIDC_TOKEN_AUTH_METHOD=client_secret_basic
# Redirect URI to register at the provider: <BASE_URL>/api/auth/callback
# Logout: POST /api/auth/logout (GET does not log out).

# Reverse-proxy header identity (X-Forwarded-User etc.), AUTH_METHOD=env only (oidc refuses to start
# with HTTP_HEADER_AUTH=true), accepted only together with X-Freeshard-Secret: <HTTP_HEADER_AUTH_SECRET>. At least 32 characters and different from
# INTERNAL_WEBHOOK_SECRET, SYSTEM_SYNC_SECRET, SESSION_SECRET and ENCRYPTION_KEY; production
# refuses to start with HTTP_HEADER_AUTH=true or AUTH_METHOD=env and no secret.
# Also required by `docker compose up`, which runs in production env mode.
#HTTP_HEADER_AUTH=true
HTTP_HEADER_AUTH_SECRET=change-me-to-a-32-char-platform-proxy-secret

# ── Default external CalDAV account (optional, injected as 'env-default') ─────
#CALDAVURL=https://cloud.example.com/remote.php/dav/calendars/user/
#CALDAV_USERNAME=user
#CALDAV_PASSWORD=
#ACCOUNT_DISPLAY_NAME=My Calendar

# Linked accounts and webcal subscriptions may only reach public addresses.
# Comma-separated hostnames that are allowed anyway (e.g. a CalDAV server on your LAN).
#OUTBOUND_FETCH_ALLOW_HOSTS=nextcloud.home.arpa

# ── Internal CalDAV server (Radicale) ────────────────────────────────────────
# For `npm run dev`. docker-compose.yml sets its own: http://caldav-server:5232 with
# RADICALE_SSL=false, plain HTTP on the private network as on a shard.
INTERNAL_CALDAV_URL=https://caldav-server:5232
RADICALE_SSL=True
# Shared secret that lets the web app and sync-worker act as any user against
# Radicale. Set a long random string in production!
SYSTEM_SYNC_SECRET=change-me

# ── Google Calendar linking (optional) ───────────────────────────────────────
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
# Redirect URI to register at Google: <BASE_URL>/api/auth/google/callback

# ── Microsoft 365 / Outlook import (optional) ────────────────────────────────
# Application (client) id of an Azure app registration (multi-tenant + personal
# accounts, tenant "common"). Hosted shards get FreeShard's central app; self-hosters
# register their own. Unset: Microsoft 365 is shown as unavailable, all else works.
# Read by the web app (OAuth with PKCE) and the sync worker (token refresh).
#MSGRAPH_CLIENT_ID=
# Only for a confidential client; a public client (PKCE only) leaves it unset.
#MSGRAPH_CLIENT_SECRET=
# Redirect URI to register at Microsoft: <BASE_URL>/api/msgraph/callback
# Scopes requested: offline_access User.Read Calendars.Read

# ── Misc ─────────────────────────────────────────────────────────────────────
# Secret for internal webhooks (e.g. user-deleted, db quiesce).
# Required: without it the internal endpoints refuse every caller. Localhost is
# never exempt, whatever TRUST_PROXY says.
INTERNAL_WEBHOOK_SECRET=change-me-to-a-secure-internal-secret
# Key for legacy encrypted public-share links (defaults to a generated .share_key file)
#SHARE_SECRET_KEY=
