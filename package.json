{
  "name": "freeshard-webcalendar",
  "version": "1.0.0",
  "description": "FreeShard WebCalendar — CalDAV web client",
  "license": "FSL-1.1-ALv2",
  "main": "server/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "lint": "node --check server/index.js server/**/*.js public/js/*.js && python3 -m py_compile sync-worker/*.py radicale/*.py",
    "test": "NODE_ENV=test node --test --test-concurrency=1 server/test/*.test.js",
    "test:e2e": "playwright test",
    "publish:containers": "node -e \"require('./server/utils/containerPublish').publishContainerImages(process.env.REGISTRY, process.env.TAG, { dryRun: process.env.DRY_RUN !== 'false' })\""
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "ical.js": "^2.1.0",
    "openid-client": "^6.0.0",
    "sqlite3": "^6.0.1",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
